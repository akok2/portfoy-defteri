{
  "name": "portfoy-defteri",
  "productName": "Portföy Defteri",
  "version": "1.0.0",
  "description": "BIST hisseleri ve TEFAS fonları için kişisel portföy takibi. Veriler bilgisayarda şifreli tutulur.",
  "main": "main.js",
  "author": "Altay",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:renderer": "python3 tools/build-renderer.py",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac -c.productName=\"Portfoy Defteri\"",
    "dist:linux": "electron-builder --linux AppImage",
    "test": "node tests/e2e.js",
    "test:birim": "node tests/birim-calistir.js",
    "test:canli": "node tests/canli-kaynaklar.js",
    "test:tutarlilik": "node tests/tutarlilik.js"
  },
  "dependencies": {
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright": "^1.63.0",
    "smtp-server": "^3.19.16"
  },
  "build": {
    "appId": "com.portfoydefteri.desktop",
    "productName": "Portföy Defteri",
    "artifactName": "PortfoyDefteri-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "build/icon.png",
      "build/tray*.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "PortfoyDefteri"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Portföy Defteri"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "identity": "-"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Finance",
      "icon": "build/icon.png",
      "executableName": "PortfoyDefteri"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KULLANICI/portfoy-defteri.git"
  }
}
